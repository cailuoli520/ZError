# 复制为 /etc/zerror/env（install.sh 会自动生成）；systemd 通过 EnvironmentFile 读取

# 监听地址；直接对外服务时用 0.0.0.0:端口
ZERROR_BIND=0.0.0.0:3000

# 管理员令牌（首次启动写入 settings.json；留空则自动生成并打印在日志中）
ZERROR_ADMIN_TOKEN=

# HTTPS：由外部证书管理器（acme.sh / certbot 等）签发的 PEM 证书链与私钥。
# 两项都填写即以 HTTPS 监听；证书文件被更新后 60 秒内自动热加载，无需重启。留空则纯 HTTP。
ZERROR_TLS_CERT=
ZERROR_TLS_KEY=

# 对外根 URL；留空自动按请求推断（推荐留空）
ZERROR_PUBLIC_URL=

# 是否信任 X-Forwarded-For / X-Forwarded-Proto（直接对外时为 false；前面有反向代理时改为 true）
ZERROR_TRUST_PROXY=false

ZERROR_LOG=info
