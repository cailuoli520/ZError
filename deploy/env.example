# 复制为 deploy/.env 后修改：cp deploy/env.example deploy/.env

# ---------- 纯 HTTP（deploy/docker-compose.yml）----------
# 对外端口，访问 http://服务器IP:PORT
PORT=3000

# 管理员令牌（首次启动写入 data/settings.json；留空则自动生成并打印在日志中）
ZERROR_ADMIN_TOKEN=

# 对外根 URL；留空自动按请求推断（推荐留空）
ZERROR_PUBLIC_URL=

ZERROR_LOG=info

# ---------- HTTPS（deploy/docker-compose.https.yml，需要域名）----------
# Caddy 站点地址：填域名即自动申请证书；仅在使用 https compose 文件时生效
SITE_ADDRESS=qa.example.com
