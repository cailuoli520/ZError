# 复制为 deploy/.env 后修改：cp deploy/env.example deploy/.env
#
# 站点地址（Caddy）
#   无域名、用 IP 通过 HTTP 访问：      SITE_ADDRESS=:80
#   有域名、自动申请证书走 HTTPS：      SITE_ADDRESS=qa.example.com   （需 80/443 可达且 DNS 已解析）
# 之后有了域名只需改这一行并执行：docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
SITE_ADDRESS=:80

# 管理员令牌（首次启动写入 data/settings.json；留空则自动生成并打印在日志中）
ZERROR_ADMIN_TOKEN=

# 对外根 URL；留空自动按请求推断（推荐留空）。若有 CDN 等多层代理可显式指定，如 https://qa.example.com
ZERROR_PUBLIC_URL=

ZERROR_LOG=info
